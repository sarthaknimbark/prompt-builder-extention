{
  "manifest_version": 3,
  "name": "PromptForge Builder",
  "description": "Create, test, version, and export structured AI prompts.",
  "version": "0.1.0",
  "action": {
    "default_title": "PromptForge Builder",
    "default_popup": "popup.html"
  },
  "options_page": "app.html",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://*/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "src/config.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
